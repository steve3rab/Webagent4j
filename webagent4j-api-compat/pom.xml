<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.webagent4j</groupId>
    <artifactId>webagent4j-parent</artifactId>
    <version>1.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>webagent4j-api-compat</artifactId>
  <packaging>pom</packaging>
  <name>WebAgent4J API Compatibility Gate</name>

  <properties>
    <revapi-java.version>0.28.4</revapi-java.version>
    <revapi-maven-plugin.version>0.15.1</revapi-maven-plugin.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.revapi</groupId>
        <artifactId>revapi-maven-plugin</artifactId>
        <version>${revapi-maven-plugin.version}</version>
        <configuration>
          <failOnUnresolvedArtifacts>true</failOnUnresolvedArtifacts>
          <failOnUnresolvedDependencies>true</failOnUnresolvedDependencies>
          <failCriticality>error</failCriticality>
          <oldArtifacts>
            <artifact>io.webagent4j:webagent4j-common:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-wait:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-locator-api:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-dom:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-observation-api:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-observation:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-locator:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-verification:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-action:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-browser-api:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-browser-playwright:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-core:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-extraction-api:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-extraction:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-crawler-api:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-crawler:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-browser-crawler:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-workflow:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-recording:${api.baseline.version}</artifact>
            <artifact>io.webagent4j:webagent4j-plugin-api:${api.baseline.version}</artifact>
          </oldArtifacts>
          <newArtifacts>
            <artifact>io.webagent4j:webagent4j-common:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-wait:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-locator-api:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-dom:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-observation-api:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-observation:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-locator:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-verification:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-action:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-browser-api:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-browser-playwright:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-core:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-extraction-api:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-extraction:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-crawler-api:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-crawler:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-browser-crawler:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-workflow:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-recording:${project.version}</artifact>
            <artifact>io.webagent4j:webagent4j-plugin-api:${project.version}</artifact>
          </newArtifacts>
          <analysisConfiguration>
            <revapi.java>
              <missing-classes>
                <behavior>error</behavior>
                <ignoreMissingAnnotations>false</ignoreMissingAnnotations>
              </missing-classes>
              <filter>
                <packages>
                  <regex>true</regex>
                  <exclude>
                    <item>io\.webagent4j\..*\.internal(\..*)?</item>
                  </exclude>
                </packages>
              </filter>
            </revapi.java>
          </analysisConfiguration>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.revapi</groupId>
            <artifactId>revapi-java</artifactId>
            <version>${revapi-java.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>api-compatibility</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
