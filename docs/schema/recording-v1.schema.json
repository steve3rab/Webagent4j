{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:webagent4j:recording:v1",
  "title": "WebAgent4J Workflow Recording V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordingId",
    "capturedAt",
    "workflow",
    "failure"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordingId": {
      "type": "string",
      "minLength": 1
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "workflow": {
      "$ref": "#/$defs/workflow"
    },
    "failure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    }
  },
  "$defs": {
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowId",
        "status",
        "steps"
      ],
      "properties": {
        "workflowId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "COMPLETED",
            "FAILED"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "stepType",
        "status",
        "condition",
        "outputVariableName",
        "failure",
        "action"
      ],
      "properties": {
        "stepId": {
          "type": "string",
          "minLength": 1
        },
        "stepType": {
          "enum": [
            "ACTION",
            "ASSIGN"
          ]
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "SKIPPED",
            "FAILED",
            "NOT_RUN"
          ]
        },
        "condition": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/condition"
            }
          ]
        },
        "outputVariableName": {
          "type": [
            "string",
            "null"
          ]
        },
        "failure": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/failure"
            }
          ]
        },
        "action": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/action"
            }
          ]
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "description"
      ],
      "properties": {
        "outcome": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "safeMessage",
        "stepId",
        "underlyingTypeName",
        "actionFailureType"
      ],
      "properties": {
        "type": {
          "enum": [
            "MISSING_REQUIRED_INPUT",
            "INPUT_TYPE_MISMATCH",
            "UNDECLARED_INPUT",
            "MISSING_VARIABLE",
            "CONDITION_EVALUATION_FAILED",
            "ACTION_FACTORY_FAILED",
            "ACTION_FAILED",
            "STEP_EXCEPTION",
            "OUTPUT_TYPE_MISMATCH",
            "NULL_OUTPUT"
          ]
        },
        "safeMessage": {
          "type": "string"
        },
        "stepId": {
          "type": [
            "string",
            "null"
          ]
        },
        "underlyingTypeName": {
          "type": [
            "string",
            "null"
          ]
        },
        "actionFailureType": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "TARGET_NOT_FOUND",
                "TARGET_AMBIGUOUS",
                "PRECONDITION_FAILED",
                "TARGET_NOT_INTERACTABLE",
                "ACTION_NOT_SUPPORTED_BY_TARGET",
                "BACKEND_FAILURE",
                "TIMEOUT",
                "POSTCONDITION_FAILED",
                "INTERRUPTED",
                "UPLOAD_FAILURE",
                "DOWNLOAD_FAILURE"
              ]
            }
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "actionType",
        "status",
        "executionMode"
      ],
      "properties": {
        "actionId": {
          "type": "string",
          "minLength": 1
        },
        "actionType": {
          "enum": [
            "CLICK",
            "DOUBLE_CLICK",
            "TYPE",
            "CLEAR",
            "SELECT",
            "CHECK",
            "UNCHECK",
            "FOCUS",
            "BLUR",
            "HOVER",
            "SCROLL",
            "SUBMIT",
            "NAVIGATE",
            "RELOAD",
            "GO_BACK",
            "GO_FORWARD",
            "UPLOAD",
            "DOWNLOAD",
            "PRESS_KEY",
            "WAIT"
          ]
        },
        "status": {
          "enum": [
            "SUCCESS",
            "PRECONDITION_FAILED",
            "EXECUTION_FAILED",
            "VERIFICATION_FAILED",
            "TIMEOUT",
            "CANCELLED"
          ]
        },
        "executionMode": {
          "enum": [
            "REAL",
            "DRY_RUN",
            "NOT_EXECUTED"
          ]
        }
      }
    }
  },
  "$comment": "This schema validates V1 field names/types/basic enums. Cross-field workflow/action invariants are stricter and are enforced by the WebAgent4J Java model and JsonWorkflowRecordingCodec; schema-valid JSON can still be rejected as an impossible execution shape."
}
