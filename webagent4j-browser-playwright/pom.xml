<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.webagent4j</groupId>
    <artifactId>webagent4j-parent</artifactId>
    <version>1.2.0</version>
  </parent>
  <artifactId>webagent4j-browser-playwright</artifactId>
  <name>WebAgent4J Playwright Browser</name>
  <dependencies>
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
    </dependency>
    <dependency>
      <groupId>io.webagent4j</groupId>
      <artifactId>webagent4j-browser-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.webagent4j</groupId>
      <artifactId>webagent4j-dom</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.webagent4j</groupId>
      <artifactId>webagent4j-locator</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.webagent4j</groupId>
      <artifactId>webagent4j-locator-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.webagent4j</groupId>
      <artifactId>webagent4j-observation</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <!--
              This module's real coverage measurement is the cross-module aggregate report (see
              docs/testing.md and webagent4j-integration-tests/pom.xml's
              coverage-check-playwright-aggregate execution, which re-applies this same 70%
              threshold to the real aggregate number): most of the Playwright adapter only exercises
              meaningfully through webagent4j-integration-tests' browser-driven IT suite, not through
              this module's own unit tests. The unit tests that do live here (e.g.
              PlaywrightScopeResolverTest) cover one class deliberately kept browser-free; they were
              never meant to reach 70% of this whole module on their own, so the per-module
              BUNDLE/LINE "check" goal is skipped here - only that one goal, on this one execution id;
              prepare-agent keeps instrumenting and the "report" execution (a separate id, untouched
              by this override) still runs, so this module's jacoco.exec and its own HTML report both
              keep working normally, and the exec still feeds the aggregate report.
            -->
            <id>coverage-check</id>
            <configuration>
              <skip>true</skip>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
