<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.webagent4j</groupId>
    <artifactId>webagent4j-parent</artifactId>
    <version>1.2.0</version>
  </parent>
  <artifactId>webagent4j-integration-tests</artifactId>
  <name>WebAgent4J Integration Tests</name>
  <dependencies>
    <dependency>
      <groupId>io.webagent4j</groupId>
      <artifactId>webagent4j-browser-crawler</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.webagent4j</groupId>
      <artifactId>webagent4j-browser-playwright</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.webagent4j</groupId>
      <artifactId>webagent4j-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.webagent4j</groupId>
      <artifactId>webagent4j-crawler</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.webagent4j</groupId>
      <artifactId>webagent4j-crawler-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.webagent4j</groupId>
      <artifactId>webagent4j-plugin-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.webagent4j</groupId>
      <artifactId>webagent4j-recording</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.webagent4j</groupId>
      <artifactId>webagent4j-testing</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.webagent4j</groupId>
      <artifactId>webagent4j-workflow</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>aggregate-report</id>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>install-playwright-chromium</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>pre-integration-test</phase>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <arguments>
                <argument>-classpath</argument>
                <classpath/>
                <argument>com.microsoft.playwright.CLI</argument>
                <argument>install</argument>
                <argument>chromium</argument>
              </arguments>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
          <execution>
            <!--
              Real, enforced replacement for the per-module coverage-check that
              webagent4j-browser-playwright's own pom.xml skips (see the comment there): the stock
              jacoco-maven-plugin "check" goal has no cross-module aggregate mode - it only ever
              analyzes the current module's own compiled classes - so PlaywrightCoverageGate reads
              the CSV this module's own "report-aggregate" execution already produces and applies the
              same 70% LINE threshold to the real combined number. Declared after the jacoco-plugin
              block so it runs after report-aggregate within the shared "verify" phase.

              The CSV path is passed explicitly as an absolute path (${project.build.directory}/...)
              rather than left to PlaywrightCoverageGate's relative-path default: exec-maven-plugin's
              "java" goal runs the main class in-process, in the same JVM as the reactor build, and
              never forks a new process for it - there is no working-directory parameter for this
              goal to set, so a relative Path resolves against the JVM's own user.dir (the directory
              `mvn` itself was launched from, i.e. the repository root in a multi-module reactor
              build), not this module's basedir. An absolute argument sidesteps that entirely.
            -->
            <id>coverage-check-playwright-aggregate</id>
            <goals>
              <goal>java</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <mainClass>io.webagent4j.integration.coverage.PlaywrightCoverageGate</mainClass>
              <arguments>
                <argument>${project.build.directory}/site/jacoco-aggregate/jacoco.csv</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!--
        Linux-CI-only: installs the OS packages Chromium needs to actually launch (libnss3,
        libatk-bridge2.0-0, etc.), via Playwright's own "install-deps" mechanism - the supported
        equivalent of Playwright's own "install with deps" flag - instead of a hand-maintained apt
        package list. Deliberately separate from the "install-playwright-chromium" execution above,
        which downloads the browser binary itself and always runs, on every OS: install-deps only
        installs system packages (it does not download the browser), calls sudo internally, and is
        not safe to run unconditionally on a normal Windows/macOS developer machine, so it stays
        opt-in behind this profile - activated explicitly in .github/workflows/ci.yml, never active
        by default.
      -->
      <id>ci-playwright-deps</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>install-playwright-host-dependencies</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>pre-integration-test</phase>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-classpath</argument>
                    <classpath/>
                    <argument>com.microsoft.playwright.CLI</argument>
                    <argument>install-deps</argument>
                    <argument>chromium</argument>
                  </arguments>
                  <classpathScope>test</classpathScope>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
