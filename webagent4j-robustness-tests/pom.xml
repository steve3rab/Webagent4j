<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.webagent4j</groupId>
    <artifactId>webagent4j-parent</artifactId>
    <version>1.1.1</version>
  </parent>
  <artifactId>webagent4j-robustness-tests</artifactId>
  <name>WebAgent4J Robustness Tests</name>
  <properties>
    <!-- Selects which Playwright-backed engine the robustness suites qualify. Must stay in
         sync with RobustnessBrowserEngine's accepted values (chromium, firefox, webkit); this
         property only controls which Playwright browser binary is installed before the test
         phase, not which engine the tests select at runtime, which is read from the same
         robustness.browser system property directly by the test JVM. -->
    <robustness.browser>chromium</robustness.browser>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.webagent4j</groupId>
      <artifactId>webagent4j-browser-playwright</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.webagent4j</groupId>
      <artifactId>webagent4j-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>install-playwright-browser</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>pre-integration-test</phase>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <arguments>
                <argument>-classpath</argument>
                <classpath/>
                <argument>com.microsoft.playwright.CLI</argument>
                <argument>install</argument>
                <argument>${robustness.browser}</argument>
              </arguments>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- See the identical profile in webagent4j-integration-tests/pom.xml for the rationale. -->
      <id>ci-playwright-deps</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>install-playwright-host-dependencies</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>pre-integration-test</phase>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-classpath</argument>
                    <classpath/>
                    <argument>com.microsoft.playwright.CLI</argument>
                    <argument>install-deps</argument>
                    <argument>${robustness.browser}</argument>
                  </arguments>
                  <classpathScope>test</classpathScope>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
